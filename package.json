{
  "name": "aroflo-connector",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:stdio": "node dist/src/transports/stdio.js",
    "start:http": "node dist/src/transports/http.js",
    "smoke:read-only": "tsc -p tsconfig.json && node dist/scripts/read-only-smoke-test.js",
    "smoke:v2-read-only": "tsc -p tsconfig.json && node dist/scripts/v2-read-only-smoke-test.js",
    "scan:secrets": "tsc -p tsconfig.json && node dist/scripts/secret-scan.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.12.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  }
}
